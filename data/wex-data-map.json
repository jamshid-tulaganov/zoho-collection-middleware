  "aura_api_patterns": {
    "base_url": "https://wexinc.my.site.com/communities/s/sfsites/aura",
    "method": "POST",
    "content_type": "application/x-www-form-urlencoded; charset=UTF-8",
    "key_endpoints": {
      "search": "SearchUiController.searchResultsKeyword — global search by company name",
      "get_record": "aura.RecordUi.getRecordWithFields — get record fields by ID",
      "get_related_list": "RelatedListContainerDataProvider.getRecords — get child records (e.g. Beneficial Owners from BOE)",
      "get_record_gvp": "RecordGvp.getRecord — another way to get record data"
    },
    "auth": {
      "method": "Aura CSRF token extracted from page JavaScript after login",
      "token_location": "window.$A.getToken() or window.$A.Hi.client.Ac",
      "session": "Salesforce session cookies (sid, etc.) — persisted via Playwright storageState"
    },
    "fwuid": "VEhtaDlVRkdCeTJiZFhuOTVYYjRJQTJEa1N5enhOU3R5QWl2VzNveFZTbGcxMy4tMjE0NzQ4MzY0OC4xMzEwNzIwMA",
    "app": "siteforce:communityApp"
  },

  "matching_strategy": {
    "problem": "WEX has no carrierId field — must match by company name + personal data validation",
    "primary_match": "Search WEX by company name → check Legal_Business_Name matches",
    "validation_fields": {
      "from_carrier_db": ["company", "derived.first_name", "derived.last_name", "derived.addr1", "derived.city", "derived.state", "derived.zip"],
      "from_wex_bop": ["First_Name__c", "Last_Name__c", "Address_Line_1", "City", "State", "Postal_Code"],
      "from_wex_app": ["Legal_Business_Name__c", "Street_Address", "Federal_Tax_ID", "DOT_Number"]
    },
    "confidence_scoring": "match on name + at least 2 address fields = high confidence"
  },

