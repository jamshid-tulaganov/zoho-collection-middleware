{
    "name": "collection-middleware",
    "version": "1.0.0",
    "description": "Collection Department data warehouse — aggregates SMP, Zoho CRM, and spreadsheet data for Metro 2 Array Credit Reports",
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "start": "node --max-old-space-size=512 src/server.js",
        "dev": "node --max-old-space-size=512 --watch src/server.js",
        "sync:carrier-db": "node scripts/sync-carrier-db.js",
        "report:send": "node scripts/send-array-report.js",
        "report:send-sync": "node scripts/send-array-report.js --sync",
        "report:send-debtors": "node scripts/send-array-report.js --debtors",
        "report:send-combined": "node scripts/send-array-report.js --combined",
        "report:financial-risk": "node scripts/send-financial-risk-report.js",
        "import:tss-collection": "node scripts/import-tss-collection-sheet.js --dry-run",
        "import:tss-collection:apply": "node scripts/import-tss-collection-sheet.js --apply",
        "db:migrate": "node scripts/migrate-to-mongodb.js --drop"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "dayjs": "^1.11.20",
        "dotenv": "^17.3.1",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "mongoose": "^9.3.1",
        "node-cron": "^4.2.1",
        "playwright-core": "^1.59.1"
    },
    "devDependencies": {
        "playwright": "^1.58.2",
        "xlsx": "^0.18.5"
    }
}
